# Go
/build/
*.exe
*.test

# Wails
app/build/bin/
app/build/darwin/*.app/
app/frontend/dist/
app/frontend/wailsjs/

# app/build/windows/ is intentionally tracked: it holds project-owned
# source customizations (manifest, NSIS installer script, icon), not
# build output. Only the generated .syso lives there transiently.
app/build/windows/*.syso

# Node
app/frontend/node_modules/
app/frontend/.vite/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Local tooling state - never commit
.claude/
